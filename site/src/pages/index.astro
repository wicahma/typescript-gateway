---
import Layout from '../layouts/Layout.astro';

const quickstart = `git clone https://github.com/wicahma/typescript-gateway
cd typescript-gateway && npm install

PORT=8088 npm start

curl http://localhost:8088/health`;

// Hyperframe frames: request lifecycle, scrubbed by scroll (CSS animation-timeline)
const frames = [
  { n: '01', title: 'ACCEPT', body: 'request hits the socket. zero allocations on the way in.' },
  { n: '02', title: 'MATCH', body: 'radix tree resolves method + path in O(log n).' },
  { n: '03', title: 'POLICIES', body: 'inbound chain: auth, cache, rate limit. first Response wins.' },
  { n: '04', title: 'FORWARD', body: 'keep-alive agent selected from the pool, request forwarded.' },
  { n: '05', title: 'RESILIENCE', body: 'circuit breaker wraps the hop. open means fail fast.' },
  { n: '06', title: 'RESPOND', body: 'transform, compress, write. context returns to the pool.' },
];

const groups = [
  { href: '/docs/core-routing', label: 'Core Routing & Proxy', desc: 'Radix router, proxy pipeline, context pooling.' },
  { href: '/docs/resilience', label: 'Resilience', desc: 'Circuit breaker, retries, health checks, fallbacks.' },
  { href: '/docs/traffic-control', label: 'Traffic Control', desc: 'Rate limiting, response cache, load balancing.' },
  { href: '/docs/payload', label: 'Payload Handling', desc: 'Body parsing, transformation, compression.' },
  { href: '/docs/observability', label: 'Observability', desc: 'Lock-free metrics, logging, live dashboard.' },
  { href: '/docs/operations', label: 'Operations', desc: 'Config validation, plugin chain, auto-tuner.' },
  { href: '/docs/identity-security', label: 'Identity & Security', desc: 'JWT, API keys, upstream credentials, RFC 7807.' },
  { href: '/docs/usage', label: 'Usage Guide', desc: 'Recipes: proxying, auth, caching, plugins.' },
  { href: '/docs/features', label: 'Feature Matrix', desc: 'All 30 features, specs, and benchmarks.' },
];
---

<Layout
  title="TypeScript Gateway — A simple gateway, it's all you need"
  description="Production-grade HTTP API gateway written in pure TypeScript with zero runtime dependencies. P99 5ms hot path, 30 features, radix router, circuit breaker, and connection pooling on native Node.js."
  canonical="https://tsgate.diama.dev/"
>
  <main>
    <section class="hero">
      <p class="mono-eyebrow">0 runtime dependencies</p>
      <h1>
        <span class="hl-line"><span>A simple gateway,</span></span>
        <span class="hl-line"><em>it's all you need.</em></span>
      </h1>

      <p class="lede">
        Pure TypeScript on native <code>node:http</code>. 30 features,
        one process, zero frameworks.
      </p>

      <div class="actions">
        <a href="/docs/getting-started" class="btn-primary">Read the docs</a>
        <a href="/docs/id/getting-started" class="btn-ghost" lang="id">Baca dalam Bahasa Indonesia</a>
        <a
          href="https://github.com/wicahma/typescript-gateway"
          class="btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </section>

    <section class="hyperframe" aria-label="Request lifecycle, scrubbed by scroll">
      <div class="hf-stage" aria-hidden="true">
        {frames.map((f, i) => (
          <pre
            class="hf-frame"
            style={`--i: ${i}; --total: ${frames.length};`}
          ><code>{`  client ──▶ gateway ──▶ upstream

  ${f.n}  ${f.title}
  ${'─'.repeat(34)}
  ${f.body}`}</code></pre>
        ))}
      </div>
      <div class="hf-caption">
        <span class="hf-label">request lifecycle</span>
        <span class="hf-track" aria-hidden="true"><span class="hf-fill"></span></span>
      </div>
    </section>

    <section class="terminal" aria-label="Quick start">
      <pre><code>{quickstart}</code></pre>
    </section>
    <section class="facts">
      <div class="fact">
        <dt>dependencies</dt>
        <dd>0</dd>
      </div>
      <div class="fact">
        <dt>hot path p99</dt>
        <dd>5ms</dd>
      </div>
      <div class="fact">
        <dt>features</dt>
        <dd>30</dd>
      </div>
      <div class="fact">
        <dt>tests</dt>
        <dd>918 ✓</dd>
      </div>
    </section>

    <section class="latest">
      <h2><span class="latest-tag">new</span> Latest additions</h2>
      <ul>
        <li><strong>WebSocket tunneling</strong><span>raw bidirectional pipe, opt-in</span></li>
        <li><strong>OpenAPI generator</strong><span>spec from the live route table</span></li>
        <li><strong>Single-flight coalescing</strong><span>stampede = 1 upstream call</span></li>
        <li><strong>Conditional revalidation</strong><span>304 merge, no body transfer</span></li>
        <li><strong>Vary-aware cache keys</strong><span>gzip / br / identity coexist</span></li>
        <li><strong>Streaming responses</strong><span>large bodies pipe, no buffering</span></li>
      </ul>
    </section>

    <section class="docs-entry">
      <h2>Documentation</h2>
      <nav class="doc-links">
        {groups.map(g => (
          <a href={g.href}>
            <span class="label">{g.label}</span>
            <span class="desc">{g.desc}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </nav>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  /* ---- hero: editorial typographic, staggered line reveal ---- */
  .hero {
    padding: 8rem 0 4.5rem;
    max-width: 860px;
  }

  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.4rem;
    display: inline-block;
    border: 1.5px solid var(--accent);
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
  }

  h1 {
    font-size: clamp(3rem, 8.5vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .hl-line {
    display: block;
    overflow: hidden;
  }

  .hl-line > span,
  .hl-line > em {
    display: inline-block;
    transform: translateY(110%);
    animation: hl-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hl-line:nth-child(2) > span,
  .hl-line:nth-child(2) > em {
    animation-delay: 0.12s;
  }

  @keyframes hl-rise {
    to { transform: translateY(0); }
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    margin-top: 1.6rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 34rem;
  }

  .lede code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
    background: var(--panel);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
  }

  .actions {
    margin-top: 2.4rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .btn-primary {
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.8rem 1.6rem;
    border-radius: 8px;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn-primary:hover {
    background: var(--ink);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    padding: 0.7rem 0.2rem;
    transition: color 0.15s ease;
  }

  .btn-ghost:hover {
    color: var(--ink);
  }

  /* ---- hyperframe: scroll-scrubbed frame sequence ---- */
  .hyperframe {
    margin: 4rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hf-stage {
    position: relative;
    height: 340px;
    overflow: hidden;
  }

  .hf-frame {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.9;
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .hyperframe {
      height: 300vh;
    }

    .hf-stage {
      position: sticky;
      top: 70px;
      height: calc(100vh - 70px);
      max-height: 640px;
    }

    /* Per-frame cover-range slices over the section's own view timeline.
       view-timeline lives on the tall section (the only element that
       actually moves); frames are absolutely positioned in the sticky
       stage, so their own view() progress would never change. */
    .hyperframe {
      view-timeline: --hf block;
    }

    .hf-frame {
      animation: hf-cycle linear both;
      animation-timeline: --hf;
      animation-duration: 1ms; /* required by spec; timeline drives progress */
      animation-range: contain calc(var(--i) / var(--total) * 100%) contain calc((var(--i) + 1) / var(--total) * 100%);
    }

    .hf-fill {
      transform-origin: left;
      animation: hf-progress linear both;
      animation-timeline: --hf;
      animation-duration: 1ms;
      animation-range: contain 0% contain 100%;
    }
  }

  @keyframes hf-cycle {
    0%, 6% { opacity: 0; transform: translateY(14px); }
    12%, 88% { opacity: 1; transform: translateY(0); }
    94%, 100% { opacity: 0; transform: translateY(-14px); }
  }

  @keyframes hf-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .hf-caption {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .hf-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .hf-track {
    flex: 1;
    height: 2px;
    background: var(--line);
    display: block;
  }

  .hf-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
  }

  /* JS fallback for browsers without scroll-driven animations */
  .hyperframe.no-sda {
    height: auto;
  }

  .hyperframe.no-sda .hf-stage {
    position: relative;
    top: 0;
    height: 340px;
  }

  .hyperframe.no-sda .hf-frame {
    animation: none;
    opacity: 1;
    display: none;
  }

  .hyperframe.no-sda .hf-frame.visible {
    display: flex;
    animation: hf-fallback-in 0.35s ease both;
  }

  @keyframes hf-fallback-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* ---- facts: mono numerals, hairline row ---- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    padding: 2.2rem 0 2.6rem;
  }

  .fact {
    padding-right: 1.5rem;
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .fact dd {
    font-family: var(--font-mono);
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---- latest additions: bold list ---- */
  .latest {
    padding: 3.5rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .latest h2 {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .latest-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--accent);
    color: #fff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  .latest ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .latest li {
    background: var(--bg);
    padding: 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: background 0.15s ease;
  }

  .latest li:hover {
    background: var(--panel);
  }

  .latest li strong {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .latest li span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }

  /* ---- docs entry: 2-col list, hover slide ---- */
  .docs-entry {
    padding: 2rem 0 6rem;
    border-top: 1px solid var(--line);
  }

  .docs-entry h2 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1.4rem;
  }

  .doc-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }

  .doc-links a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.15s ease;
  }

  .doc-links .label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .doc-links .desc {
    font-size: 0.8rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .doc-links .arrow {
    color: var(--muted);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.15s ease;
  }

  .doc-links a:hover {
    border-bottom-color: var(--accent);
  }

  .doc-links a:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ---- responsive ---- */
  @media (max-width: 768px) {
    .hero {
      padding: 4.5rem 0 3rem;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 1.4rem 1rem;
    }
    .doc-links {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .latest ul {
      grid-template-columns: 1fr;
    }
    .doc-links .desc {
      display: none;
    }
    .hyperframe {
      height: auto;
    }
    .hf-stage {
      position: relative;
      top: 0;
      height: 320px;
    }
    .hf-frame {
      animation: none !important;
      opacity: 1 !important;
      display: none;
    }
    .hf-frame.visible {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hl-line > span,
    .hl-line > em {
      animation: none;
      transform: none;
    }
    .hf-frame,
    .hf-fill {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
    .hf-frame:not(:first-child) {
      display: none;
    }
  }
</style>

<script>
  // Hyperframe scrub driver (JS, always-on). Continuous rAF loop with
  // document.hidden + reduced-motion guards, no scroll listeners, no deps.
  // (CSS scroll-driven path dropped: support signals lie; IO gating
  // untestable in some engines. One rect read per frame is cheap.)
  (function () {
    const section = document.querySelector('.hyperframe');
    if (!section) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const frames = [...section.querySelectorAll('.hf-frame')];
    const fill = section.querySelector('.hf-fill');
    const total = frames.length;
    let raf = 0;

    function show(idx, progress) {
      frames.forEach((f, j) => f.classList.toggle('visible', j === idx));
      if (fill) fill.style.transform = `scaleX(${progress})`;
    }

    function jsScrub() {
      section.classList.add('no-sda');
      const tick = () => {
        if (!document.hidden && !reduce) {
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight;
          const onScreen = rect.bottom > 0 && rect.top < vh;
          if (onScreen) {
            // progress 0..1 as the section travels through the viewport
            const p = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
            const idx = Math.min(total - 1, Math.floor(p * total));
            show(idx, p);
          }
        }
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
      show(0, 0);
    }

    if (reduce) {
      show(0, 0);
      return;
    }
    jsScrub();
  })();
</script>
