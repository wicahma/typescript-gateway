</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const host = btn.closest('.install') ?? btn.closest('.panel-card');
      const pre = host?.querySelector('pre');
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = 'copied ✓';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'copy';
          btn.classList.remove('copied');
        }, 1600);
      } catch {
        btn.textContent = 'select';
      }
    });
  });

  const logWindow = document.getElementById('logWindow');
  const loadSlider = document.getElementById('loadSlider');
  const rateReadout = document.getElementById('rateReadout');

  if (logWindow && loadSlider instanceof HTMLInputElement && rateReadout) {
    let reqPerSec = 1;
    let accumulator = 0;
    let lastTime = performance.now();

    const paths = [
      '/api/users',
      '/api/orders',
      '/api/products',
      '/api/search',
      '/api/health',
      '/api/bench',
    ];
    const methods = ['GET', 'GET', 'GET', 'POST', 'POST', 'PUT', 'DELETE'];
    const statuses = [200, 200, 200, 200, 200, 200, 200, 200, 200, 200, 200, 200, 200, 200, 201, 201, 304, 304, 429, 500];

    function sample<T>(arr: readonly T[], fallback: T): T {
      const item = arr[Math.floor(Math.random() * arr.length)];
      return item !== undefined ? item : fallback;
    }

    function nextLine(): string {
      const d = new Date();
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      const ss = String(d.getSeconds()).padStart(2, '0');
      const ms = String(d.getMilliseconds()).padStart(3, '0');
      const time = `${hh}:${mm}:${ss}.${ms}`;

      const method = sample(methods, 'GET');
      const path = sample(paths, '/api/users');
      const status = sample(statuses, 200);
      const duration = `${(Math.random() * 3.5 + 0.5).toFixed(1)}ms`;

      return `${time}  ${method}  ${path}  ${status}  ${duration}`;
    }

    function appendLines(count: number): void {
      if (!logWindow || count <= 0) return;
      const frag = document.createDocumentFragment();
      for (let i = 0; i < count; i++) {
        const lineEl = document.createElement('div');
        lineEl.style.whiteSpace = 'pre';
        lineEl.style.overflow = 'hidden';
        lineEl.style.textOverflow = 'ellipsis';
        lineEl.textContent = nextLine();
        frag.appendChild(lineEl);
      }
      logWindow.appendChild(frag);

      while (logWindow.children.length > 200) {
        const first = logWindow.firstElementChild;
        if (first) {
          first.remove();
        } else {
          break;
        }
      }

      logWindow.scrollTop = logWindow.scrollHeight;
    }

    loadSlider.addEventListener('input', () => {
      const t = Number(loadSlider.value);
      reqPerSec = Math.round(Math.pow(80000, t / 1000));
      rateReadout.textContent = `${reqPerSec.toLocaleString('en-US')} req/s`;
    });

    appendLines(1);

    function step(now: number): void {
      const elapsed = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      const renderRate = reqPerSec > 60 ? 60 : reqPerSec;
      accumulator += elapsed * renderRate;
      let count = Math.floor(accumulator);
      accumulator -= count;

      if (count > 5) {
        count = 5;
        accumulator = 0;
      }

      appendLines(count);
      requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }
</script>
