---
import Layout from '../layouts/Layout.astro';

const quickstart = `git clone https://github.com/wicahma/typescript-gateway
cd typescript-gateway && npm install

PORT=8088 npm start

curl http://localhost:8088/health`;

const groups = [
  { href: '/docs/core-routing', label: 'Core Routing & Proxy', desc: 'Radix router, proxy pipeline, context pooling.' },
  { href: '/docs/resilience', label: 'Resilience', desc: 'Circuit breaker, retries, health checks, fallbacks.' },
  { href: '/docs/traffic-control', label: 'Traffic Control', desc: 'Rate limiting, response cache, load balancing.' },
  { href: '/docs/payload', label: 'Payload Handling', desc: 'Body parsing, transformation, compression.' },
  { href: '/docs/observability', label: 'Observability', desc: 'Lock-free metrics, logging, live dashboard.' },
  { href: '/docs/operations', label: 'Operations', desc: 'Config validation, plugin chain, auto-tuner.' },
  { href: '/docs/identity-security', label: 'Identity & Security', desc: 'JWT, API keys, upstream credentials, RFC 7807.' },
  { href: '/docs/features', label: 'Feature Matrix', desc: 'All 24 features, specs, and benchmarks.' },
];
---

<Layout
  title="TypeScript Gateway — A simple gateway, it's all you need"
  description="Production-grade HTTP API gateway written in pure TypeScript with zero runtime dependencies. P99 5ms hot path, 24 features, radix router, circuit breaker, and connection pooling on native Node.js."
  canonical="https://tsgate.diama.dev/"
>
  <main>
    <section class="hero">
      <h1>
        A simple gateway,<br />
        <em>it's all you need.</em>
      </h1>

      <p class="lede">
        An ordinary API gateway — pure TypeScript on native <code>node:http</code>.
        No framework, no runtime packages. 24 features, one process:
        reverse proxy, radix routing, circuit breaking, connection pooling.
      </p>

      <div class="actions">
        <a href="/docs/getting-started" class="btn-primary">Read the docs →</a>
        <a
          href="https://github.com/wicahma/typescript-gateway"
          class="btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </section>

    <section class="terminal" aria-label="Quick start">
      <pre><code>{quickstart}</code></pre>
    </section>

    <section class="facts">
      <div class="fact">
        <dt>dependencies</dt>
        <dd>0</dd>
      </div>
      <div class="fact">
        <dt>hot path p99</dt>
        <dd>5ms</dd>
      </div>
      <div class="fact">
        <dt>features</dt>
        <dd>24</dd>
      </div>
      <div class="fact">
        <dt>tests</dt>
        <dd>898 ✓</dd>
      </div>
    </section>

    <section class="docs-entry">
      <h2>Documentation</h2>
      <nav class="doc-links">
        {groups.map(g => (
          <a href={g.href}>
            <span class="label">{g.label}</span>
            <span class="desc">{g.desc}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </nav>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .hero {
    padding: 6.5rem 0 3.5rem;
    max-width: 760px;
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 620px;
  }

  .lede code {
    font-size: 0.88em;
    background: var(--panel);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--accent);
    color: #fff;
    transition: background 0.15s ease;
  }

  .btn-primary:hover {
    background: #1e3fd1;
  }

  .btn-ghost {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }

  .btn-ghost:hover {
    color: var(--accent);
  }

  .terminal {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
    margin-bottom: 4rem;
    max-width: calc(100% - 1px);
  }

  .terminal pre {
    padding: 1.5rem 1.6rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--ink);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 2.25rem 0;
    margin-bottom: 5rem;
  }

  .fact {
    padding: 0 2rem;
    border-left: 1px solid var(--line);
  }

  .fact:first-child {
    padding-left: 0;
    border-left: none;
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .fact dd {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .docs-entry {
    padding-bottom: 5.5rem;
  }

  .docs-entry h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .doc-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 3rem;
  }

  .doc-links a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.1rem 0.25rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease;
  }

  .doc-links .label {
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .doc-links .desc {
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }

  .doc-links .arrow {
    color: var(--line);
    font-weight: 400;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .doc-links a:hover .label {
    color: var(--accent);
  }

  .doc-links a:hover .arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  @media (max-width: 860px) {
    .doc-links {
      grid-template-columns: 1fr;
    }
    .facts {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.75rem;
    }
    .fact:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding: 4rem 0 2.5rem;
    }
  }
</style>
