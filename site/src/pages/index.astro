---
import Layout from '../layouts/Layout.astro';
import pkg from '../../package.json';

const quickstart = `git clone https://github.com/wicahma/typescript-gateway
cd typescript-gateway && npm install
PORT=8088 npm start
curl http://localhost:8088/health`;

const config = `{
  "server": { "port": 8088 },
  "routes": [{ "method": "GET", "path": "/api/*" }],
  "upstreams": [
    { "id": "backend", "host": "localhost", "port": 3000 }
  ]
}`;

const terminal = `$ curl http://localhost:8088/api/test
{"id":"test"}          # 200 OK — proxied to localhost:3000
$ curl http://localhost:8088/health
{"status":"ok"}`;

const version = pkg.version;

const steps = [
  { n: '01', title: 'ACCEPT', body: 'request hits the socket. zero allocations on the way in.' },
  { n: '02', title: 'MATCH', body: 'radix tree resolves method + path in O(log n).' },
  { n: '03', title: 'POLICIES', body: 'inbound chain: auth, cache, rate limit. first Response wins.' },
  { n: '04', title: 'FORWARD', body: 'keep-alive agent selected from the pool, request forwarded.' },
  { n: '05', title: 'RESILIENCE', body: 'circuit breaker wraps the hop. open means fail fast.' },
  { n: '06', title: 'RESPOND', body: 'transform, compress, write. context returns to the pool.' },
];

const caps = [
  { group: 'core routing', items: ['Radix Router', 'Reverse Proxy', 'Request Pipeline', 'Context Pool', 'WebSocket Tunneling', 'OpenAPI Generator', 'Disconnect Propagation', 'Request Coalescing', 'Streaming Path'] },
  { group: 'resilience', items: ['Circuit Breaker', 'Retry Manager', 'Health Checker', 'Fallback Handler', 'Timeout Manager'] },
  { group: 'traffic control', items: ['Rate Limiter', 'Response Cache', 'Load Balancer'] },
  { group: 'payload', items: ['Body Parser', 'Request Transformer', 'Response Transformer', 'Compression'] },
  { group: 'observability', items: ['Metrics Histogram', 'Structured Logger', 'Performance Dashboard', 'Access Log Sampling', 'CPU & Memory Profiler'] },
  { group: 'operations', items: ['Config Loader & Validator', 'Plugin Execution Chain', 'Auto Tuner'] },
  { group: 'identity & security', items: ['JWT Auth', 'API Keys', 'Upstream Credential Injection', 'RFC 7807 Problem Details'] },
];

const bench = [
  { s: 'Sustained 100 conn × 60 s', direct: '55,369 req/s', gw: '53,081 req/s', d: '−4.1%' },
  { s: 'Plain GET /api/bench', direct: '78,498 req/s', gw: '50,323 req/s', d: '−35.9%' },
  { s: 'Large body, gzip', direct: '20,068 req/s', gw: '12,903 req/s', d: '−35.7%' },
  { s: 'Slow upstream, 200 ms', direct: '49 req/s', gw: '49 req/s', d: '−0%' },
  { s: 'Slow 100 ms + cacheable', direct: '98 req/s', gw: '30,677 req/s', d: '~313×' },
  { s: 'Failing upstream (500)', direct: '77,120 req/s', gw: '28,178 req/s', d: '−63.5% fail-fast' },
];

const docs = [
  { href: '/docs/getting-started', label: 'Getting Started', desc: 'install, first config, first plugin' },
  { href: '/docs/architecture', label: 'Architecture & Pipeline', desc: 'request lifecycle, socket to upstream' },
  { href: '/docs/configuration', label: 'Configuration Reference', desc: 'every option in gateway.config.json' },
  { href: '/docs/usage', label: 'Usage Guide', desc: 'recipes: proxying, auth, caching, plugins' },
  { href: '/docs/core-routing', label: 'Core Routing & Proxy', desc: 'radix router, proxy pipeline, pooling' },
  { href: '/docs/resilience', label: 'Resilience', desc: 'breaker, retries, health, fallbacks' },
  { href: '/docs/traffic-control', label: 'Traffic Control', desc: 'rate limits, cache, load balancing' },
  { href: '/docs/payload', label: 'Payload Handling', desc: 'parsing, transformation, compression' },
  { href: '/docs/observability', label: 'Observability', desc: 'metrics, logging, live dashboard' },
  { href: '/docs/operations', label: 'Operations', desc: 'config validation, plugin chain, tuner' },
  { href: '/docs/identity-security', label: 'Identity & Security', desc: 'JWT, API keys, RFC 7807' },
  { href: '/docs/features', label: 'Feature Matrix', desc: 'every feature and benchmark' },
];
---

<Layout
  title="TypeScript Gateway — A simple gateway, it's all you need"
  description="Production-grade HTTP API gateway written in pure TypeScript with zero runtime dependencies. P99 5ms hot path, 49 features, radix router, circuit breaker, and connection pooling on native Node.js."
  canonical="https://tsgate.diama.dev/"
>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">MIT · 0 runtime dependencies · node &ge; 20 · v{version}</p>
        <h1>
          <span class="hl-line"><span>The API gateway</span></span>
          <span class="hl-line"><em>for Node.js.</em></span>
        </h1>

        <p class="lede">
          Pure TypeScript on native <code>node:http</code>. No framework, no runtime
          dependencies &mdash; just a radix tree and a keep-alive pool. 49 features
          in one process: routing, auth, caching, rate limits, circuit breaking, metrics.
        </p>

        <div class="install">
          <div class="install-head">
            <span class="file">quickstart</span>
            <button type="button" class="copy-btn" data-copy aria-label="Copy quick start commands">copy</button>
          </div>
          <pre><code>{quickstart}</code></pre>
        </div>

        <div class="actions">
          <a href="/docs/getting-started" class="btn-primary">Get started</a>
          <a
            href="https://github.com/wicahma/typescript-gateway"
            class="btn-ghost"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
          <a href="/id/docs/getting-started" class="lang-link" lang="id">Bahasa Indonesia</a>
        </div>
      </div>

      <div class="hero-panel" aria-label="A minimal gateway config and its result">
        <div class="panel-card">
          <div class="panel-head">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="file">gateway.config.json</span>
            <button type="button" class="copy-btn" data-copy aria-label="Copy example config">copy</button>
          </div>
          <pre><code>{config}</code></pre>
        </div>
        <div class="panel-card">
          <div class="panel-head">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="file">terminal</span>
          </div>
          <pre><code>{terminal}</code></pre>
        </div>
        <p class="panel-note">the whole config. everything else has sensible defaults.</p>
      </div>
    </section>

    <section class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span>GET /api/users → 200 · 3.2ms</span><span>POST /api/orders → 201 · 12ms</span><span>GET /api/products → 304 · 0.4ms</span><span>cache HIT · x-cache: STALE → refreshed</span><span>circuit CLOSED · upstream backend-1</span><span>GET /api/search → 200 · gzip 78%</span><span>rate-limit OK · 412/500 req</span><span>WS tunnel established · /socket</span><span>GET /api/users → 200 · 3.2ms</span><span>POST /api/orders → 201 · 12ms</span><span>GET /api/products → 304 · 0.4ms</span><span>cache HIT · x-cache: STALE → refreshed</span><span>circuit CLOSED · upstream backend-1</span><span>GET /api/search → 200 · gzip 78%</span><span>rate-limit OK · 412/500 req</span><span>WS tunnel established · /socket</span>
      </div>
    </section>

    <section class="lifecycle" aria-label="Request lifecycle in six steps">
      <p class="sec-label">request lifecycle</p>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n">{s.n}</span>
            <strong>{s.title}</strong>
            <span class="step-body">{s.body}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="facts">
      <div class="fact">
        <dt>runtime deps</dt>
        <dd>0</dd>
      </div>
      <div class="fact">
        <dt>hot path p99</dt>
        <dd>5ms</dd>
      </div>
      <div class="fact">
        <dt>features</dt>
        <dd>30</dd>
      </div>
      <div class="fact">
        <dt>tests</dt>
        <dd>950 ✓</dd>
      </div>
    </section>

    <section class="caps">
      <p class="sec-label">capability index</p>
      <h2>Everything a proxy needs</h2>
      <div class="cap-ledger">
        {caps.map((c) => (
          <div class="cap-row">
            <span class="cap-group">{c.group}</span>
            <ul>
              {c.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="caps-note">
        Every capability ships with unit and integration coverage in the repo.
        Details in the <a href="/docs/features">feature matrix</a>.
      </p>
    </section>

    <section class="bench">
      <p class="sec-label">benchmarks</p>
      <h2>Overhead, with the receipts</h2>
      <div class="bench-scroll">
        <table>
          <thead>
            <tr><th>Scenario</th><th>Direct upstream</th><th>Through tsgate</th><th>Δ</th></tr>
          </thead>
          <tbody>
            {bench.map((b) => (
              <tr>
                <td>{b.s}</td>
                <td>{b.direct}</td>
                <td>{b.gw}</td>
                <td class={b.d.startsWith('~') ? 'delta-win' : 'delta'}>{b.d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="bench-note">
        macOS arm64 · Node v22.21.1 · loopback · 2026-10-05. The fast-path tax is proxy
        parse/socket cost in JavaScript; it disappears on latency-bound upstreams and
        inverts with the response cache. Full method and caveats:
        <a href="/docs/testing">testing &amp; benchmarks</a>.
      </p>
    </section>

    <section class="docs-entry">
      <p class="sec-label">documentation</p>
      <h2>Read the manual</h2>
      <nav class="doc-links">
        {docs.map((d) => (
          <a href={d.href}>
            <span class="label">{d.label}</span>
            <span class="desc">{d.desc}</span>
            <span class="arrow">→</span>
          </a>
        ))}
      </nav>
      <p class="docs-note">
        Seluruh panduan juga tersedia dalam
        <a href="/id/docs/getting-started" lang="id">Bahasa Indonesia</a>.
      </p>
    </section>

    <section class="closing">
      <h2>Start routing.</h2>
      <p>
        One JSON file. One process. Nothing to install at runtime &mdash;
        everything else has sensible defaults.
      </p>
      <div class="actions">
        <a href="/docs/getting-started" class="btn-primary">Get started</a>
        <a
          href="https://github.com/wicahma/typescript-gateway"
          class="btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .sec-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }

  /* ---- hero: copy left, real product surface right ---- */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
    padding: 6.5rem 0 4.5rem;
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 1.4rem;
  }

  h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .hl-line {
    display: block;
  }

  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    margin-top: 1.6rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 34rem;
  }

  .lede code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
    background: var(--panel);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
  }

  .install {
    margin-top: 2.2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    max-width: 30rem;
  }

  .install-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .install-head .file {
    flex: 1;
  }

  .install pre {
    padding: 1rem 1.2rem;
    font-size: 0.78rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .install code::before {
    content: '$ ';
    color: var(--accent);
    white-space: pre;
  }

  .copy-btn {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .copy-btn:hover,
  .copy-btn.copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  .actions {
    margin-top: 2.2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .btn-primary {
    background: var(--accent);
    color: #0b0b0d;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.8rem 1.6rem;
    border-radius: 8px;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn-primary:hover {
    background: #8aa3ff;
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    padding: 0.7rem 0.2rem;
    transition: color 0.15s ease;
  }

  .btn-ghost:hover {
    color: var(--ink);
  }

  .lang-link {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line);
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .lang-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* hero right: two stacked product cards */
  .hero-panel {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .panel-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #26262c;
  }

  .file {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    flex: 1;
  }

  .panel-card .copy-btn {
    position: static;
  }

  .panel-card pre {
    padding: 1rem 1.2rem;
    font-size: 0.78rem;
    line-height: 1.75;
    overflow-x: auto;
    color: var(--ink);
  }

  .panel-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* ---- ticker: request-log marquee ---- */
  .ticker {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding: 0.55rem 0;
  }

  .ticker-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: ticker-scroll 40s linear infinite;
  }

  .ticker-track span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  /* ---- lifecycle: six steps, always visible ---- */
  .lifecycle {
    padding: 3.2rem 0 3rem;
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.2rem;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--line);
    position: relative;
  }

  .steps li::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 2.2rem;
    height: 2px;
    background: var(--accent);
  }

  .step-n {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent);
  }

  .steps strong {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .step-body {
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---- facts: mono numerals, hairline row ---- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 2.2rem 0 2.6rem;
  }

  .fact {
    padding-right: 1.5rem;
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .fact dd {
    font-family: var(--font-mono);
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---- capability index: ledger, no cards ---- */
  .caps {
    padding: 3.5rem 0 3rem;
  }

  .caps h2,
  .bench h2,
  .docs-entry h2,
  .closing h2 {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.6rem;
  }

  .cap-ledger {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }

  .cap-row {
    display: flex;
    gap: 1.2rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .cap-group {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
    width: 10.5rem;
    flex-shrink: 0;
  }

  .cap-row ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
  }

  .cap-row li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.12rem 0.5rem;
    white-space: nowrap;
  }

  .caps-note {
    margin-top: 1.2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .caps-note a,
  .bench-note a,
  .docs-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- benchmarks: table with receipts ---- */
  .bench {
    padding: 3rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .bench-scroll {
    overflow-x: auto;
  }

  .bench table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .bench th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    color: var(--muted);
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }

  .bench td {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.65rem 1rem 0.65rem 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .bench td:first-child {
    font-family: var(--font-sans);
    color: var(--ink);
    white-space: normal;
  }

  .bench td:nth-child(2),
  .bench td:nth-child(3) {
    color: var(--muted);
  }

  .delta {
    color: var(--muted);
  }

  .delta-win {
    color: var(--accent);
    font-weight: 700;
  }

  .bench-note {
    margin-top: 1.2rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 44rem;
  }

  /* ---- docs entry: 2-col list, hover slide ---- */
  .docs-entry {
    padding: 3rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .doc-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }

  .doc-links a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.15s ease;
  }

  .doc-links .label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .doc-links .desc {
    font-size: 0.8rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .doc-links .arrow {
    color: var(--muted);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.15s ease;
  }

  .doc-links a:hover {
    border-bottom-color: var(--accent);
  }

  .doc-links a:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .docs-note {
