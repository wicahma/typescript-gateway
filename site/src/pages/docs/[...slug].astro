---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const en = (await getCollection('docs')).map(doc => ({ params: { slug: doc.id }, props: { doc, lang: 'en' as const } }));
  const id = (await getCollection('docs-id')).map(doc => ({ params: { slug: `id/${doc.id}` }, props: { doc, lang: 'id' as const } }));
  return [...en, ...id];
}

const { doc, lang } = Astro.props;
const { Content } = await render(doc);

const collection = lang === 'id' ? 'docs-id' : 'docs';
const allDocs = (await getCollection(collection)).sort((a, b) => a.data.order - b.data.order);
const guides = allDocs.filter(d => d.data.track === 'guide');
const refs = allDocs.filter(d => d.data.track === 'reference');

const enDocs = await getCollection('docs');
const idDocs = await getCollection('docs-id');
const idSet = new Set(idDocs.map(d => d.id));

const baseId = doc.id;
const altLang = lang === 'id' ? 'en' : 'id';
const altAvailable = lang === 'id' ? enDocs.some(d => d.id === baseId) : idSet.has(baseId);
const altHref = lang === 'id' ? `/docs/${baseId}` : `/docs/id/${baseId}`;

const t = {
  sidebar: lang === 'id' ? 'Dokumentasi' : 'Documentation',
  guide: lang === 'id' ? 'Panduan' : 'Guides',
  reference: lang === 'id' ? 'Referensi' : 'Reference',
  edit: lang === 'id' ? 'Sarankan perubahan di GitHub ↗' : 'Suggest an edit on GitHub ↗',
  langSwitch: lang === 'id' ? 'EN' : 'ID',
};
---

<Layout
  title={`${doc.data.title} — TypeScript Gateway Docs`}
  description={doc.data.description}
  canonical={`https://tsgate.diama.dev/docs/${lang === 'id' ? `id/${doc.id}` : doc.id}`}
>
  <div class="docs-wrapper">
    <aside class="sidebar">
      <div class="sidebar-head">
        <span class="mono-label">{t.sidebar}</span>
        {altAvailable ? (
          <a href={altHref} class="lang-switch" title={altLang === 'id' ? 'Bahasa Indonesia' : 'English'}>{t.langSwitch}</a>
        ) : (
          <a href={lang === 'id' ? `/docs/${baseId}` : '/docs/getting-started'} class="lang-switch" title="English">{t.langSwitch}</a>
        )}
      </div>
      <nav class="sidebar-nav">
        <span class="nav-group">{t.guide}</span>
        {guides.map(item => (
          <a
            href={lang === 'id' ? `/docs/id/${item.id}` : `/docs/${item.id}`}
            class:list={['nav-item', { active: item.id === doc.id }]}
          >
            <span class="nav-text">{item.data.title}</span>
          </a>
        ))}
        <span class="nav-group">{t.reference}</span>
        {refs.map(item => (
          <a
            href={lang === 'id' ? `/docs/id/${item.id}` : `/docs/${item.id}`}
            class:list={['nav-item', { active: item.id === doc.id }]}
          >
            <span class="nav-text">{item.data.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <article class="content">
      <header class="content-header doc-reveal">
        <p class="section-badge">{doc.data.track === 'guide' ? t.guide : t.reference}</p>
        <h1 class="doc-title">{doc.data.title}</h1>
        <p class="description">{doc.data.description}</p>
      </header>

      <div class="prose doc-reveal d1">
        <Content />
      </div>

      <div class="doc-footer-nav">
        <a href="https://github.com/wicahma/typescript-gateway" target="_blank" rel="noopener noreferrer" class="edit-link">
          {t.edit}
        </a>
      </div>
    </article>
  </div>

  <script define:vars={{ allDocs: allDocs.map(d => ({ id: d.id, title: d.data.title, desc: d.data.description, section: d.data.section })), langPrefix: lang === 'id' ? '/docs/id/' : '/docs/' }}>
    function initDocsSearch() {
      const trigger = document.getElementById('search-trigger');
      const overlay = document.getElementById('search-overlay');
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      if (!trigger || !overlay || !input || !results) return;

      function fuzzy(needle, haystack) {
        let score = 0;
        let hi = 0;
        let prev = -2;
        const nl = needle.toLowerCase();
        const hl = haystack.toLowerCase();
        for (let i = 0; i < nl.length; i++) {
          const c = nl[i];
          let found = -1;
          for (let j = hi; j < hl.length; j++) {
            if (hl[j] === c) { found = j; break; }
          }
          if (found === -1) return -1;
          if (found === prev + 1) score += 2;
          else if (found === 0 || hl[found - 1] === ' ' || hl[found - 1] === '/') score += 3;
          else score += 1;
          prev = found;
          hi = found + 1;
        }
        return score;
      }

      function search(q) {
        const out = [];
        for (const doc of allDocs) {
          let s = fuzzy(q, doc.title) * 2;
          if (s < 0) s = fuzzy(q, doc.section + ' ' + doc.desc);
          if (s > 0) out.push({ doc, s });
        }
        out.sort((a, b) => b.s - a.s);
        return out.map(o => o.doc);
      }

      function renderResults(q) {
        results.innerHTML = '';
        if (!q) { overlay.classList.add('open'); return; }
        const hits = search(q);
        if (!hits.length) {
          results.innerHTML = '<div class="search-empty">No results for “' + q.replace(/</g, '&lt;') + '”</div>';
          return;
        }
        for (const doc of hits) {
          const a = document.createElement('a');
          a.href = langPrefix + doc.id;
          a.className = 'search-item';
          a.innerHTML = '<span class="search-title">' + doc.title.replace(/</g, '&lt;') + '</span>' +
            '<span class="search-desc">' + (doc.desc || '').replace(/</g, '&lt;') + '</span>';
          results.appendChild(a);
        }
      }

      function open() {
        overlay.classList.add('open');
        input.value = '';
        renderResults('');
        input.focus();
        document.body.style.overflow = 'hidden';
      }
      function close() {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', open);
      overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); open(); }
        if (e.key === 'Escape' && overlay.classList.contains('open')) close();
      });
      input.addEventListener('input', () => renderResults(input.value.trim()));
      results.addEventListener('click', e => {
        if (e.target.closest('a')) close();
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDocsSearch);
    } else {
      initDocsSearch();
    }
  </script>
</Layout>

<style>
  .docs-wrapper {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 4rem;
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .doc-reveal {
      animation: doc-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .doc-reveal.d1 {
      animation-delay: 0.1s;
    }
  }

  @keyframes doc-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .sidebar {
    position: sticky;
    top: 5.5rem;
    height: fit-content;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }

  .sidebar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-switch:hover {
    background: var(--accent);
    color: #fff;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }

  .nav-group {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    opacity: 0.75;
    margin: 1.1rem 0 0.35rem;
  }

  .nav-group:first-child {
    margin-top: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 0;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--ink);
  }

  .nav-item.active {
    color: var(--accent);
    font-weight: 600;
  }

  .content {
    min-width: 0;
  }

  .content-header {
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--line);
  }

  .section-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  .doc-title {
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .description {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .prose :global(h1) {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 2.5rem 0 1.1rem;
  }

  .prose :global(h1:first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    font-size: 1.28rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 2.5rem 0 1rem;
    text-wrap: balance;
  }

  .prose :global(h3) {
    font-size: 1.02rem;
    font-weight: 600;
    margin: 1.7rem 0 0.7rem;
  }

  .prose :global(p) {
    margin-bottom: 1.15rem;
    line-height: 1.75;
    color: #3f3f46;
  }

  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 1.15rem 1.5rem;
    color: #3f3f46;
    line-height: 1.75;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(pre) {
    background: var(--panel) !important;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.15rem 1.3rem;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
    margin: 1.25rem 0;
  }

  .prose :global(pre code),
  .prose :global(pre code span) {
    background: none !important;
    padding: 0;
    color: var(--ink) !important;
    font-style: normal !important;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--panel);
    border-radius: 5px;
    padding: 0.12rem 0.4rem;
    color: var(--accent);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.1rem;
    margin: 1.25rem 0;
    color: var(--muted);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.86rem;
  }

  .prose :global(th), .prose :global(td) {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: var(--muted);
  }

  .prose :global(a) {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .doc-footer-nav {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .edit-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .edit-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .docs-wrapper {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sidebar {
      position: static;
      border-bottom: 1px solid var(--line);
      padding-bottom: 1.25rem;
    }
    .sidebar-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 1.1rem;
    }
    .nav-group {
      width: 100%;
      margin-top: 0.9rem;
    }
    .nav-item {
      padding: 0.2rem 0;
    }
  }
</style>
