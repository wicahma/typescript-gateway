---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(doc => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

const sectionColors: Record<string, string> = {
  'Guide': 'var(--coral)',
  'Architecture': 'var(--violet)',
  'Configuration': 'var(--teal)',
  'Features': 'var(--amber)',
};
const accent = sectionColors[doc.data.section] ?? 'var(--violet)';
---

<Layout
  title={`${doc.data.title} — TypeScript Gateway Docs`}
  description={doc.data.description}
  canonical={`https://tsgate.diama.dev/docs/${doc.id}`}
>
  <div class="docs-wrapper">
    <aside class="sidebar">
      <div class="sidebar-head">
        <span class="mono-label">Docs index</span>
      </div>
      <nav class="sidebar-nav">
        {
          allDocs.map(item => (
            <a
              href={`/docs/${item.id}`}
              class:list={['nav-item', { active: item.id === doc.id }]}
            >
              <span class="num">{String(item.data.order).padStart(2, '0')}</span>
              <span class="nav-text">{item.data.title}</span>
            </a>
          ))
        }
      </nav>
    </aside>

    <article class="content">
      <div class="content-header">
        <p class="section-badge" style={`--badge: ${accent};`}>{doc.data.section}</p>
        <h1 class="doc-title">{doc.data.title}</h1>
        <p class="description">{doc.data.description}</p>
      </div>

      <div class="prose">
        <Content />
      </div>
      <div class="doc-footer-nav">
        <a href="https://github.com/wicahma/typescript-gateway" target="_blank" rel="noopener noreferrer" class="edit-link">
          Suggest an edit on GitHub ↗
        </a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .docs-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 3.5rem;
    width: 100%;
  }

  .sidebar {
    position: sticky;
    top: 5rem;
    height: fit-content;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 1rem;
    border-left: 2px solid var(--border);
    padding-left: 0.85rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.55rem;
    border-radius: 9px;
    color: var(--ink-muted);
    font-size: 0.87rem;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-item .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    opacity: 0.7;
  }

  .nav-item:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .nav-item.active {
    color: var(--ink);
    font-weight: 700;
    background: var(--surface-2);
  }

  .nav-item.active .num {
    color: var(--coral);
    opacity: 1;
    font-weight: 700;
  }

  .content {
    min-width: 0;
  }

  .content-header {
    border-bottom: 2px solid var(--border);
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
  }

  .section-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--badge);
    background: color-mix(in srgb, var(--badge) 14%, transparent);
    border: 1.5px solid var(--badge);
    border-radius: 999px;
    padding: 0.2rem 0.8rem;
    margin-bottom: 1rem;
  }

  .doc-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  .description {
    font-size: 1.02rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* Prose styling */
  .prose :global(h1) {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }

  .prose :global(h2) {
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 2.4rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--surface-2);
    text-wrap: balance;
  }

  .prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 1.7rem 0 0.7rem;
    color: var(--ink);
  }

  .prose :global(p) {
    margin-bottom: 1.2rem;
    line-height: 1.75;
    color: #463a5e;
  }

  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 1.2rem 1.5rem;
    color: #463a5e;
    line-height: 1.75;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(li::marker) {
    color: var(--coral);
    font-weight: 700;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(pre) {
    background: #2b2140;
    color: #f5efe6;
    border-radius: 12px;
    padding: 1.15rem 1.3rem;
    overflow-x: auto;
    font-size: 0.83rem;
    line-height: 1.7;
    margin: 1.25rem 0;
    border: 1.5px solid var(--ink);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.87em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--surface-2);
    border-radius: 5px;
    padding: 0.12rem 0.4rem;
    color: var(--coral);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--amber);
    background: var(--amber-soft);
    border-radius: 0 10px 10px 0;
    padding: 0.75rem 1.1rem;
    margin: 1.25rem 0;
    color: var(--ink);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1.5rem 0;
    font-size: 0.86rem;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    overflow: hidden;
  }

  .prose :global(th), .prose :global(td) {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(th) {
    background: var(--violet-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  .prose :global(tr:nth-child(even) td) {
    background: var(--surface);
  }

  .prose :global(a) {
    color: var(--violet);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--coral);
  }

  .doc-footer-nav {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border);
  }

  .edit-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .edit-link:hover {
    color: var(--coral);
  }

  @media (max-width: 768px) {
    .docs-wrapper {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sidebar {
      position: static;
      border-bottom: 2px solid var(--border);
      padding-bottom: 1.5rem;
    }
    .sidebar-nav {
      display: flex;
      flex-wrap: wrap;
      border-left: none;
      padding-left: 0;
      gap: 0.4rem;
    }
    .nav-item {
      background: var(--surface);
      border: 1px solid var(--border);
    }
    .nav-item.active {
      background: var(--coral-soft);
      border-color: var(--coral);
    }
  }
</style>
