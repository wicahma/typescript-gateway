---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "A simple gateway, it's all you need. Production-grade TypeScript HTTP API gateway with zero runtime dependencies.",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://tsgate.diama.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script defer data-domain="tsgate.diama.dev" src="https://analytics.diama.dev/js/script.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TypeScript Gateway" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TypeScript Gateway",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "url": siteUrl
    })} />

    <style is:global>
      :root {
        --bg: #0b0b0d;
        --ink: #f2f2f4;
        --muted: #9d9da6;
        --line: rgba(255, 255, 255, 0.09);
        --panel: #131316;
        --accent: #6d8cff;

        --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        color: var(--ink);
        color-scheme: dark;
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        scroll-behavior: smooth;
        /* no overflow-x here: overflow on <html> breaks position:sticky descendants */
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code, pre {
        font-family: var(--font-mono);
      }

      ::selection {
        background: var(--accent);
        color: #0b0b0d;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: #26262c;
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #3a3a42;
      }

      /* ---- nav ---- */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(11, 11, 13, 0.85);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }

      .nav-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        font-size: 1.02rem;
        letter-spacing: -0.02em;
      }

      .brand-mark {
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: #2952ff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.66rem;
        font-weight: 700;
        font-family: var(--font-mono);
      }

      .links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        color: var(--muted);
        transition: color 0.15s ease;
      }

      .nav-link:hover {
        color: var(--ink);
      }

      .github-link {
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .github-link:hover {
        color: var(--accent);
      }

      /* ---- footer ---- */
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: auto;
        padding: 2.5rem 1.5rem;
      }

      .footer-container {
        max-width: 1120px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.25rem;
      }

      .footer-copy .tag {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--muted);
      }

      .footer-copy a,
      .footer-links a {
        color: var(--muted);
        font-size: 0.86rem;
      }

      .footer-copy a:hover,
      .footer-links a:hover {
        color: var(--accent);
      }

      .footer-links {
        display: flex;
        gap: 1.4rem;
      }

      @media (max-width: 640px) {
        .nav-container {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
        .links {
          gap: 0.8rem;
          font-size: 0.8rem;
          flex-wrap: wrap;
          justify-content: flex-start;
        }
        .github-link {
          font-size: 0.72rem;
        }
        .footer-container {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-container">
        <a href="/" class="brand">
          <span class="brand-mark">ts</span>
          TypeScript Gateway
        </a>

        <nav class="links">
          <a href="/docs/getting-started" class="nav-link">Docs</a>
          <a href="/docs/features" class="nav-link">Features</a>
          <a href="/docs/configuration" class="nav-link">Config</a>
          <a
            href="https://github.com/wicahma/typescript-gateway"
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
          >
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-copy">
          <p class="tag">Zero runtime dependencies · MIT License</p>
        </div>
        <div class="footer-links">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/features">Features</a>
          <a href="https://github.com/wicahma/typescript-gateway" target="_blank" rel="noopener noreferrer">Repository</a>
          <a href="https://github.com/wicahma" target="_blank" rel="noopener noreferrer">@wicahma</a>
        </div>
      </div>
    </footer>
  </body>
</html>
