---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "A simple gateway, it's all you need. Production-grade TypeScript HTTP API gateway with zero runtime dependencies.",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://tsgate.diama.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script defer data-domain="tsgate.diama.dev" src="https://analytics.diama.dev/js/script.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TypeScript Gateway" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TypeScript Gateway",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "url": siteUrl
    })} />

    <style is:global>
      :root {
        --bg: #050303;
        --ink: #ffffff;
        --muted: rgba(255, 255, 255, 0.58);
        --soft: rgba(255, 255, 255, 0.85);
        --line: rgba(255, 255, 255, 0.07);
        --stroke: rgba(255, 255, 255, 0.06);
        --panel: #0b0a0e;
        --accent: #6d8cff;
        --brand: #2952ff;

        --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;

        --shell: 1280px;
        --pad: clamp(1.25rem, 4vw, 2.75rem);
        --radius: 32px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        color: var(--ink);
        color-scheme: dark;
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code, pre {
        font-family: var(--font-mono);
      }

      ::selection {
        background: var(--accent);
        color: #050303;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: #232228;
        border-radius: 6px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #35333c;
      }

      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: clamp(0.75rem, 2vw, 1.1rem) var(--pad);
      }

      .nav-container {
        max-width: var(--shell);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 0.7rem 0.6rem 1.1rem;
        border-radius: var(--radius);
        border: 1px solid var(--stroke);
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 20px 60px rgba(0, 0, 0, 0.5);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: -0.01em;
        white-space: nowrap;
      }

      .brand-mark {
        width: 26px;
        height: 26px;
        border-radius: 9px;
        background: var(--brand);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.66rem;
        font-weight: 700;
        font-family: var(--font-mono);
        flex-shrink: 0;
      }

      .links {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        font-weight: 500;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        color: var(--muted);
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        transition: color 0.18s ease, background 0.18s ease;
      }

      .nav-link:hover {
        color: var(--ink);
        background: rgba(255, 255, 255, 0.06);
      }

      .github-link {
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: border-color 0.18s ease, color 0.18s ease;
      }

      .github-link:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: auto;
        padding: 3rem var(--pad);
      }

      .footer-container {
        max-width: var(--shell);
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.25rem;
      }

      .footer-copy .tag {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        color: var(--muted);
      }

      .footer-copy a,
      .footer-links a {
        color: var(--muted);
        font-size: 0.86rem;
        transition: color 0.18s ease;
      }

      .footer-copy a:hover,
      .footer-links a:hover {
        color: var(--accent);
      }

      .footer-links {
        display: flex;
        gap: 1.4rem;
        flex-wrap: wrap;
      }

      @media (max-width: 720px) {
        :root {
          --radius: 24px;
        }
        .nav-container {
          flex-wrap: wrap;
          justify-content: center;
          padding: 0.7rem 1rem;
        }
        .links {
          justify-content: center;
          font-size: 0.84rem;
        }
        .nav-link {
          padding: 0.45rem 0.7rem;
        }
        .footer-container {
          flex-direction: column;
          align-items: flex-start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-container">
        <a href="/" class="brand">
          <span class="brand-mark">ts</span>
          TypeScript Gateway
        </a>

        <nav class="links">
          <a href="/docs/getting-started" class="nav-link">Docs</a>
          <a href="/docs/features" class="nav-link">Features</a>
          <a href="/docs/configuration" class="nav-link">Config</a>
          <a
            href="https://github.com/wicahma/typescript-gateway"
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
          >
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-copy">
          <p class="tag">Zero runtime dependencies. MIT License.</p>
        </div>
        <div class="footer-links">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/features">Features</a>
          <a href="https://github.com/wicahma/typescript-gateway" target="_blank" rel="noopener noreferrer">Repository</a>
          <a href="https://github.com/wicahma" target="_blank" rel="noopener noreferrer">@wicahma</a>
        </div>
      </div>
    </footer>
  </body>
</html>
