---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = "A simple gateway, it's all you need. Production-grade TypeScript HTTP API gateway with zero runtime dependencies.",
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = "https://tsgate.diama.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TypeScript Gateway" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232952ff'/%3E%3Cpath d='M10 22V12l6-3 6 3v10' stroke='%23fff' stroke-width='2.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TypeScript Gateway",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "url": siteUrl
    })} />

    <style is:global>
      :root {
        --bg: #ffffff;
        --ink: #141414;
        --muted: #71717a;
        --line: #e7e7e8;
        --panel: #f6f6f7;
        --accent: #2952ff;

        --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        scroll-behavior: smooth;
        /* no overflow-x here: overflow on <html> breaks position:sticky descendants */
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code, pre {
        font-family: var(--font-mono);
      }

      ::selection {
        background: var(--accent);
        color: #fff;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--line);
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--muted);
      }

      /* ---- nav ---- */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 2px solid var(--ink);
      }

      .nav-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        font-size: 1.02rem;
        letter-spacing: -0.02em;
      }

      .brand-mark {
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: var(--accent);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.66rem;
        font-weight: 700;
        font-family: var(--font-mono);
      }

      .links {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-link {
        color: var(--muted);
        transition: color 0.15s ease;
      }

      .nav-link:hover {
        color: var(--ink);
      }

      .github-link {
        color: var(--ink);
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .github-link:hover {
        color: var(--accent);
      }

      /* ---- search ---- */
      .search-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--muted);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 7px;
        padding: 0.3rem 0.6rem;
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .search-trigger:hover {
        color: var(--ink);
        border-color: var(--muted);
      }

      .search-trigger kbd {
        font-family: inherit;
        font-size: 0.62rem;
        color: var(--muted);
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.05rem 0.3rem;
        background: var(--bg);
      }

      .search-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(20, 20, 20, 0.35);
        padding: 12vh 1rem 0;
        justify-content: center;
      }

      .search-overlay.open {
        display: flex;
      }

      .search-panel {
        width: 100%;
        max-width: 560px;
        height: fit-content;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
      }

      .search-input {
        width: 100%;
        border: none;
        outline: none;
        padding: 0.9rem 1.1rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
      }

      .search-input::placeholder {
        color: var(--muted);
      }

      .search-results {
        max-height: 50vh;
        overflow-y: auto;
      }

      .search-item {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        padding: 0.65rem 1.1rem;
        border-bottom: 1px solid var(--line);
      }

      .search-item:last-child {
        border-bottom: none;
      }

      .search-item:hover {
        background: var(--panel);
      }

      .search-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink);
      }

      .search-item:hover .search-title {
        color: var(--accent);
      }

      .search-desc {
        font-size: 0.78rem;
        color: var(--muted);
      }

      .search-empty {
        padding: 1.1rem;
        font-size: 0.85rem;
        color: var(--muted);
      }

      /* ---- footer ---- */
      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: auto;
        padding: 2.5rem 1.5rem;
      }

      .footer-container {
        max-width: 1120px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.25rem;
      }

      .footer-copy .tag {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--muted);
      }

      .footer-copy a,
      .footer-links a {
        color: var(--muted);
        font-size: 0.86rem;
      }

      .footer-copy a:hover,
      .footer-links a:hover {
        color: var(--accent);
      }

      .footer-links {
        display: flex;
        gap: 1.4rem;
      }

      @media (max-width: 640px) {
        .nav-container {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
        .links {
          gap: 0.8rem;
          font-size: 0.8rem;
          flex-wrap: wrap;
          justify-content: flex-start;
        }
        .github-link {
          font-size: 0.72rem;
        }
        .search-trigger kbd {
          display: none;
        }
        .footer-container {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-container">
        <a href="/" class="brand">
          <span class="brand-mark">ts</span>
          TypeScript Gateway
        </a>

        <nav class="links">
          <button id="search-trigger" class="search-trigger" type="button" aria-label="Search docs">
            Search
            <kbd>Ctrl K</kbd>
          </button>
          <a href="/docs/getting-started" class="nav-link">Docs</a>
          <a href="/docs/architecture" class="nav-link">Architecture</a>
          <a href="/docs/features" class="nav-link">Features</a>
          <a href="/docs/configuration" class="nav-link">Config</a>
          <a
            href="https://github.com/wicahma/typescript-gateway"
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
          >
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-label="Search documentation">
      <div class="search-panel">
        <input id="search-input" class="search-input" type="text" placeholder="Search docs…" autocomplete="off" />
        <div id="search-results" class="search-results"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-copy">
          <p class="tag">Zero runtime dependencies · MIT License</p>
        </div>
        <div class="footer-links">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/features">Features</a>
          <a href="https://github.com/wicahma/typescript-gateway" target="_blank" rel="noopener noreferrer">Repository</a>
          <a href="https://github.com/wicahma" target="_blank" rel="noopener noreferrer">@wicahma</a>
        </div>
      </div>
    </footer>
  </body>
</html>
