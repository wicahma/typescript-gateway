{
  "name": "typescript-gateway",
  "version": "1.0.0",
  "description": "Ultra-high-performance API gateway achieving sub-10ms P99 latency and 150k+ req/s throughput",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:perf": "vitest run tests/performance",
    "test:watch": "vitest",
    "benchmark": "node benchmarks/load-test.js",
    "benchmark:router": "tsx benchmarks/router-benchmark.ts",
    "benchmark:context": "tsx benchmarks/context-pool-benchmark.ts",
    "benchmark:plugins": "tsx benchmarks/plugin-execution-benchmark.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api-gateway",
    "high-performance",
    "low-latency",
    "proxy",
    "router",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
